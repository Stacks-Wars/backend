# HTTP bind address
HOST=0.0.0.0
PORT=8080

# Required — server will not start without working connections
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stacks_wars
REDIS_URL=redis://127.0.0.1:6379

# Shared with the Next.js frontend for POST /users sync
INTERNAL_API_SECRET=change-me-to-a-long-random-secret

RUST_LOG=info,sw_server=debug
