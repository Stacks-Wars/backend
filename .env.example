# HTTP bind address
HOST=0.0.0.0
PORT=8080

# Required — server will not start without these
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stacks_wars
# Railway (on sw-server service): REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=redis://127.0.0.1:6379
HIRO_API_KEY=
# Same base URL as frontend Neon Auth (JWKS at …/.well-known/jwks.json)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# Deployed vault: deployer.contract-name
SW_VAULT_CONTRACT=SP299MBHT7FPPP2SKEY73V4DHW67467SED87A4HH4.sw-vault-v1
# Shared with Next.js (x-internal-secret for cron / server-to-server calls)
INTERNAL_API_SECRET=

# Public web origin for Telegram deep links (default https://stackswars.com)
FRONTEND_URL=https://stackswars.com
# SQL migrations dir (Docker image sets /app/migrations; local cargo run auto-detects)
MIGRATIONS_DIR=./migrations

# Telegram companion (optional — both required to enable)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Admin allowlist (optional, comma-separated emails). Empty = no admins.
# ADMIN=you@example.com

# Optional overrides (defaults are mainnet)
# HIRO_API_URL=https://api.hiro.so
# STACKS_NETWORK=mainnet

# Product constants are hardcoded in sw-server (min/max withdraw, min entry,
# USDCx contract, 5m balance cache TTL).

RUST_LOG=info,sw_server=debug
