# Local (`cargo run`) needs no .env. Compose:
#   docker compose up -d postgres redis
#
# Production: `--main` (Dockerfile CMD). HOST, PORT, and MIGRATIONS_DIR
# are already set in the image — do not set them on Railway.

# APP_URL=https://www.stackswars.com
# DATABASE_URL=
# REDIS_URL=
# INTERNAL_API_SECRET=
# HIRO_API_KEY=
# HELIUS_API_KEY=

# Optional
# ADMIN=you@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
